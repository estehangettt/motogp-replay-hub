# Flask
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0

# PulseLive public API
PULSELIVE_BASE_URL=https://api.motogp.pulselive.com/motogp/v1
PULSELIVE_TIMEOUT=15

# Scraper source. Only use pages and media you are authorized to access.
MOTOMUNDO_BASE_URL=https://motomundo.net/
SCRAPER_TIMEOUT=15

# Optional comma-separated host allowlist for authorized HLS sources.
# Example: media.example.com,cdn.example.com
HLS_ALLOWED_HOSTS=
